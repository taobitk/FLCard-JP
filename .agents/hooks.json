{
  "secret-shield": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "view_file|grep_search|replace_file_content|multi_replace_file_content|write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "python \".agents/security_guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
